{
  "name": "@aussieljk/singlefile",
  "version": "0.2.0",
  "description": "Bundle a React app into a single HTML file",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "singlefile": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts --outdir dist --format esm --sourcemap --external esbuild-wasm --external fflate && bun x tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "bundler",
    "esbuild",
    "single-file",
    "html",
    "browser"
  ],
  "author": "Lucas Knight",
  "license": "MIT",
  "peerDependencies": {
    "esbuild-wasm": ">=0.20.0",
    "fflate": ">=0.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "esbuild-wasm": "^0.27.7",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3"
  }
}
